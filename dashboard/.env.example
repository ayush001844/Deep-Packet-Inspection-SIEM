# ==============================================================================
# DeepGuard Dashboard — Vercel Environment Variables
# ==============================================================================
# Copy this to .env.local for local development or set these in the Vercel
# project dashboard under Settings → Environment Variables.
# ==============================================================================

# Backend API URL (no trailing slash)
# Local dev: leave empty — Vite proxy handles /api/* → localhost:8000
# Vercel production: set to your deployed backend URL
# e.g. https://deepguard-backend.railway.app
VITE_API_BASE_URL=

# Backend WebSocket URL
# Local dev: leave empty — auto-detected from window.location
# Vercel production: wss://deepguard-backend.railway.app
VITE_WS_BASE_URL=
